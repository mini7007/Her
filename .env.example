# ─────────────────────────────────────────────────────────────────────────────
# IF YOU COULD HEAR MY HEART — environment configuration
# Copy this file to .env.local for local development, and add every value to
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit .env.local or real secret values to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret. Bypasses Row Level Security. Used by the API routes and
# the owner dashboard to read/write response data. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (https://resend.com → API Keys) ───────────────────────────────────
RESEND_API_KEY=
# Optional. A verified "From" address, e.g. "Mohan <love@yourdomain.com>".
# If omitted, Resend's test sender "onboarding@resend.dev" is used.
RESEND_FROM=

# ── Owner / notification target ──────────────────────────────────────────────
# The Supabase Auth account with this exact email is the only one allowed to
# open the /owner dashboard. Also the recipient of response notification emails.
OWNER_EMAIL=mohan5050390@gmail.com

# ── Public site URL (used for the owner-dashboard link inside emails) ────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
